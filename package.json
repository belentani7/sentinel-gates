{
  "name": "@belentani7/sentinel-gates",
  "version": "0.1.0",
  "description": "Plantilla SEDA/CSG para calidad, seguridad y gobernanza de proyectos TypeScript.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "docs",
    "templates"
  ],
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "biome check . && npm run typecheck",
    "check:ci": "biome ci . && npm run typecheck",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "vitest run tests/e2e",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run",
    "audit": "npm audit --audit-level=high",
    "arch:check": "node scripts/architecture-check.mjs",
    "verify": "npm run check && npm run arch:check && npm run test:coverage && npm run test:integration && npm run test:e2e && npm run audit && npm run build"
  },
  "keywords": [
    "quality-gates",
    "security",
    "seda",
    "csg",
    "typescript",
    "github-actions"
  ],
  "license": "MIT",
  "overrides": {
    "qs": "6.15.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/belentani7/sentinel-gates.git"
  },
  "bugs": {
    "url": "https://github.com/belentani7/sentinel-gates/issues"
  },
  "homepage": "https://github.com/belentani7/sentinel-gates#readme",
  "devDependencies": {
    "@biomejs/biome": "2.2.2",
    "@stryker-mutator/core": "9.6.1",
    "@stryker-mutator/typescript-checker": "9.6.1",
    "@stryker-mutator/vitest-runner": "9.6.1",
    "@types/node": "22.18.0",
    "@vitest/coverage-v8": "3.2.7",
    "typescript": "5.9.2",
    "vitest": "3.2.7"
  }
}
